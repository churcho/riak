#!/bin/sh

ULIMIT_WARN=65536
ULIMIT_F=`ulimit -n`

# "unlimited" satisfies any threshold — only warn for numeric values
if [ "$ULIMIT_F" != "unlimited" ] && [ "$ULIMIT_F" -lt $ULIMIT_WARN ]; then
    echo "!!!!"
    echo "!!!! WARNING: ulimit -n is ${ULIMIT_F}; ${ULIMIT_WARN} is the recommended minimum."
    echo "!!!!"
fi
