%% @doc OTP application resource file for the Riak Admin REST API.
%%
%% This application provides a modern REST API for Riak cluster
%% administration, built on Cowboy 2.x. It runs alongside Riak's
%% existing Webmachine-based HTTP API (default port 10018) on a
%% dedicated port (default 8099) as the first step toward replacing
%% the legacy Webmachine stack with Cowboy.
%%
%% == Isolation principle ==
%%
%% The `applications' list deliberately excludes riak_core and
%% riak_kv. Those are the runtime host, not compile-time
%% dependencies. All calls to Riak internals go through a single
%% gateway module (riak_admin_api_riak.erl) which resolves them
%% at runtime. This means `rebar3 compile' works without Riak
%% source present, and the app can be extracted to its own repo
%% by changing one line in Riak's rebar.config (path -> git).
%%
%% The `mod' tuple tells OTP to call riak_admin_api_app:start/2
%% when the application boots. The `env' section provides default
%% configuration overridable via advanced.config or sys.config.

{application, riak_admin_api, [
    {description, "Riak Admin REST API - Cowboy-based cluster management"},
    {vsn, "0.1.0"},
    {registered, [riak_admin_api_sup, riak_admin_api_coordinator]},
    {mod, {riak_admin_api_app, []}},
    {applications, [
        kernel,
        stdlib,
        cowboy,   %% HTTP server (replacing Webmachine for admin endpoints)
        jsx,      %% JSON encoding/decoding for API responses
        syn       %% Distributed process registry for DC discovery
        %% NOTE: riak_core and riak_kv are NOT listed here.
        %% They are runtime hosts, not compile-time dependencies.
        %% See riak_admin_api_riak.erl for the isolation pattern.
    ]},
    {env, [
        {http_port, 8099},        %% Default admin API port; distinct from Riak HTTP (10018)
        {dc_name, <<"default">>}, %% Datacenter name for multi-DC identification
        {riak_http_port, 8098},   %% Local Riak HTTP port (for DC metadata)
        {cowboy_cutover_default_mode, enabled},
        {cowboy_cutover_op_modes, []}
    ]},
    {modules, []}
]}.
