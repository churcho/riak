%% rebar.config for riak_admin_api
%%
%% This is the sub-application rebar config. The deps listed here
%% are also declared in the top-level riak/rebar.config to ensure
%% version consistency across the umbrella project. If you update
%% a version here, update the top-level rebar.config to match.

{erl_opts, [debug_info]}.

{deps, [
    {cowboy, "2.12.0"},   %% HTTP server — handles admin API requests
    {jsx, "3.1.0"}        %% JSON encoder/decoder for API responses
]}.
